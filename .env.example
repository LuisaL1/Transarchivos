# Copie este archivo como ".env.local" (desarrollo) o configure la variable en
# Vercel → Project Settings → Environment Variables (producción).
#
# ID de medición de Google Analytics 4. Se obtiene en:
# analytics.google.com → Administrar → Flujos de datos → Web → "ID de medición".
# Si se deja vacío, Google Analytics no se carga.
VITE_GA_MEASUREMENT_ID=

# SEO (ver docs/06-seo.md)
# "true" SOLO cuando www.transarchivos.com apunte a este sitio: quita el noindex,
# abre robots.txt y publica el sitemap. Configurarlo en Vercel (entorno Production).
VITE_SITE_INDEXABLE=
# Opcional: código de verificación de Google Search Console (método "etiqueta HTML").
# Si verifica el dominio por DNS (recomendado), déjelo vacío.
VITE_GOOGLE_SITE_VERIFICATION=

# Formularios → correo (solo en Vercel, NUNCA con prefijo VITE_: es secreto)
# Ver docs/07-formularios.md
BREVO_API_KEY=
LEADS_TO=mercadeo@transarchivos.com
LEADS_TO_GENERAL=info@transarchivos.com
LEADS_TO_NEWSLETTER=marketing@transarchivos.com
LEADS_FROM=no-reply@transarchivos.com
LEADS_FROM_NAME=Transarchivos
# Dominio de producción del que se cargan las imágenes de los correos
# (por defecto https://www.transarchivos.com)
EMAIL_ASSETS_URL=

# Cotizador → tickets en Zoho Desk (solo en Vercel y en .env.local; SECRETAS,
# nunca con prefijo VITE_). Ver docs/07-formularios.md
ZOHO_DESK_CLIENT_ID=
ZOHO_DESK_CLIENT_SECRET=
ZOHO_DESK_REFRESH_TOKEN=
ZOHO_DESK_ORG_ID=
ZOHO_DESK_DEPARTMENT_ID=
# Opcionales: centro de datos (por defecto https://accounts.zoho.com y https://desk.zoho.com)
ZOHO_DESK_ACCOUNTS_URL=
ZOHO_DESK_API_URL=

# Proxies de confianza delante del sitio, para el límite de envíos por IP
# (por defecto 1: el del hosting; súmele 1 si hay una CDN delante). Ver docs/09-hosting-nodejs.md
TRUSTED_PROXY_HOPS=
