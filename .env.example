# Copie este archivo como ".env.local" (desarrollo) o configure la variable en
# Vercel → Project Settings → Environment Variables (producción).
#
# ID de medición de Google Analytics 4. Se obtiene en:
# analytics.google.com → Administrar → Flujos de datos → Web → "ID de medición".
# Si se deja vacío, Google Analytics no se carga.
VITE_GA_MEASUREMENT_ID=

# SEO (ver docs/06-seo.md)
# "true" SOLO cuando www.transarchivos.com apunte a este sitio: quita el noindex,
# abre robots.txt y publica el sitemap. Configurarlo en Vercel (entorno Production).
VITE_SITE_INDEXABLE=
# Opcional: código de verificación de Google Search Console (método "etiqueta HTML").
# Si verifica el dominio por DNS (recomendado), déjelo vacío.
VITE_GOOGLE_SITE_VERIFICATION=

# Formularios → correo (solo en Vercel, NUNCA con prefijo VITE_: es secreto)
# Ver docs/07-formularios.md
BREVO_API_KEY=
LEADS_TO=mercadeo@transarchivos.com
LEADS_TO_GENERAL=info@transarchivos.com
LEADS_TO_NEWSLETTER=marketing@transarchivos.com
LEADS_FROM=no-reply@transarchivos.com
LEADS_FROM_NAME=Transarchivos
# Dominio de producción para las imágenes de los correos (por defecto https://transarchivos.vercel.app;
# cámbielo a https://www.transarchivos.com cuando el dominio apunte a Vercel)
EMAIL_ASSETS_URL=

# ─── Chat con un asesor dentro de Joel (Zoho SalesIQ, ver docs/08-chat-asesor.md) ───
# Solo en Vercel (Production) y, para probar en este equipo, en .env.local
# (NO versionado). SECRETAS: nunca con prefijo VITE_. Sin ellas, el chat con
# un asesor usa el puente con el widget de Zoho (modo activo hoy).
# Self Client de https://api-console.zoho.com con los alcances
# SalesIQ.conversations.CREATE, SalesIQ.conversations.READ, SalesIQ.Apps.READ y
# SalesIQ.departments.READ.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Clave larga y aleatoria para firmar el acceso a cada conversación
# (por ejemplo: openssl rand -base64 48)
ADVISOR_SECRET=
# Nombre del portal en la dirección de SalesIQ (por defecto "transarchivos";
# confírmelo en la URL del panel de SalesIQ)
ZOHO_SALESIQ_SCREEN=
# Opcionales: si faltan se usan la primera marca y el primer departamento
# (pnpm advisor:check los muestra)
ZOHO_SALESIQ_APP_ID=
ZOHO_SALESIQ_DEPARTMENT_ID=
# Centro de datos de Zoho (por defecto el de .com)
ZOHO_ACCOUNTS_URL=
ZOHO_SALESIQ_URL=
